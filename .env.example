# ─────────────────────────────────────────────────────────────────────────
# SimpleBackupSystem (SBS) — secrets / machine-specific settings
# Copy this file to ".env" and fill in the values. ".env" is gitignored.
# ─────────────────────────────────────────────────────────────────────────

# Full path of the OneDrive folder to back up.
# Tip: use forward slashes or escape backslashes; both work.
SOURCE_FOLDER=C:\Users\you\OneDrive\Documents

# Azure Storage account name (just the name, not the full URL).
STORAGE_ACCOUNT=yourstorageaccount

# Azure Storage SAS token.
# Generate at: Storage Account > Shared access signature
#   Allowed services      : Blob
#   Allowed resource types: Container, Object
#   Allowed permissions   : Write, Add, Create (Read/List optional)
#   Set an expiry date.
# The token can be saved with or without the leading "?".
SAS_TOKEN=?sv=2024-...&ss=b&srt=co&sp=wac&se=...&st=...&spr=https&sig=...
